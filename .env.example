# Server-only: origin of the FastAPI backend. The browser calls relative /api/... URLs, which the
# next.config.ts rewrite proxies to this origin (so session cookies are first-party).
# BUILD-TIME: `next build` bakes the rewrite into .next/routes-manifest.json, so set BACKEND_URL
# before building; changing it for `next start` alone has no effect. `npm run gen:api` also reads it.
BACKEND_URL=http://127.0.0.1:8000

# Phase 2 (unified platform): origins of the embedded external apps shown inside the shell at /apps/*.
# BUILD-TIME: `next build` inlines NEXT_PUBLIC_* into the client bundle, so set these before building.
# Local defaults are the *.localhost hostnames used by the dev reverse proxy.
NEXT_PUBLIC_CROAR_URL=http://croar.localhost
NEXT_PUBLIC_FEEDBACK_IQ_URL=http://feedbackiq.localhost
NEXT_PUBLIC_PORTAL_URL=http://jobs.localhost
